# Copy to .env.local and fill in. Nothing here is required to run `npm run verify`
# (simulate mode works with zero setup) — these matter for SPENDVETO_MODE=testnet.

# Real agent output instead of the canned fallback. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Which rail to use. simulate = zero setup, no blockchain calls, real Claude calls
# if ANTHROPIC_API_KEY is set. testnet = real x402 protocol on Base Sepolia.
SPENDVETO_MODE=simulate

# Only needed for SPENDVETO_MODE=testnet — generate both with `npm run gen-wallets`.
CLIENT_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS=

# Optional — only used when calling the solana-devnet chain in testnet mode.
# Base58-encoded 64-byte Solana secret key (e.g. `solana-keygen new`, then
# `cat ~/.config/solana/id.json | node -e "..."` to base58-encode, or export
# from Phantom). Left unset, a fresh ephemeral keypair is generated per run —
# fine to exercise the rail, but it will never hold funded devnet USDC.
CLIENT_SOLANA_PRIVATE_KEY=

# Same pattern for every other family the public facilitator settles today —
# each optional, each falls back to an ephemeral (unfunded) key when unset.
# Base payout addresses (SERVER_PAYOUT_ADDRESS_*) are separate from client
# keys: without one set, that family's chain never enters liveSettlementChains,
# whatever the facilitator supports — see server/index.js.

# Aptos testnet — AIP-80 or hex private key from `aptos init` / Petra export.
CLIENT_APTOS_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_APTOS=

# Stellar testnet — classic (G) account secret key, starts with "S".
CLIENT_STELLAR_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_STELLAR=

# Hedera testnet — NO ephemeral fallback exists (an account id is assigned
# on-chain, not derived from a key). Create a free one at
# https://portal.hedera.com, then set both.
CLIENT_HEDERA_ACCOUNT_ID=
CLIENT_HEDERA_PRIVATE_KEY=
SERVER_PAYOUT_ADDRESS_HEDERA=

# XRPL — MAINNET, not testnet: this is the one chain in the registry
# settling real money. Family secret ("s...", from `xrpl-cli wallet create`
# or any XRPL wallet's seed export). Leave unset unless you mean it.
CLIENT_XRPL_SEED=
SERVER_PAYOUT_ADDRESS_XRPL=

# SVM payout address (Base58 Solana address) — required alongside
# CLIENT_SOLANA_PRIVATE_KEY above for solana-devnet to go live.
SERVER_PAYOUT_ADDRESS_SVM=

# x402 v2 facilitator override (default: https://x402.org/facilitator).
# Point at Coinbase CDP's facilitator + configure your CDP API key to unlock mainnet chains.
# SPENDVETO_FACILITATOR_URL=

# API-spend rail rates, USD per million tokens (set from your provider's price sheet)
# LLM_RATE_IN_PER_M=1.0
# LLM_RATE_OUT_PER_M=1.0
# LLM_MODEL=claude-haiku-4-5-20251001
